{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": false,
  "prCreation": "immediate",
  "automerge": true,
  "automergeType": "pr",
  "requiredStatusChecks": [
    "integration-tests"
  ],
  "recreateWhen": "always",
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchPackagePatterns": [
        "*"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchPackagePatterns": [
        "*"
      ],
      "allowedVersions": "!/(alpha|beta|rc)/i",
      "ignoreUnstable": true
    }
  ]
}
